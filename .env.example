# Platform Configuration
PORT=3000
NODE_ENV="development"

# App URL for public routing and tenant resolution
APP_URL="http://localhost:3000"

# Required in production: generate one unique random secret (at least 32 bytes),
# save it in the host dashboard, and never rotate it casually. Changing it logs
# every owner/editor/viewer session out; recovery keys still restore owner access.
SESSION_SECRET=""

# Private key for the unlinked platform-owner archive deletion screen.
PLATFORM_ADMIN_KEY=""

# Durable archive storage (required for public production deployment)
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""
# Vercel's Supabase integration may inject the equivalent aliases
# VITE_SUPABASE_URL and service_role. Canonical names above are preferred.
# SUPABASE_SERVICE_ROLE_KEY is also accepted as an alternative variable name.

# Cloudflare R2 media storage (server secrets; never prefix with VITE_)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="oncehere-media"

# Alternative S3-compatible storage, including Backblaze B2.
# When these are set, they are used instead of the R2 variables above.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_BUCKET="oncehere-media"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"
