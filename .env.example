# Platform Configuration
PORT=3000
NODE_ENV="development"

# App URL for public routing and tenant resolution
APP_URL="http://localhost:3000"

# Required in production: generate one unique random secret (at least 32 bytes),
# save it in the host dashboard, and never rotate it casually. Changing it logs
# every owner/editor/viewer session out; recovery keys still restore owner access.
SESSION_SECRET=""

# Private key for the unlinked platform-owner archive deletion screen.
PLATFORM_ADMIN_KEY=""

# Durable archive storage (required for public production deployment).
# These are server-only values. Never prefix either one with VITE_.
TURSO_DATABASE_URL="libsql://your-database-your-org.turso.io"
TURSO_AUTH_TOKEN=""

# Cloudflare R2 media storage (server secrets; never prefix with VITE_)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="oncehere-media"

# Alternative S3-compatible storage, including Backblaze B2.
# When these are set, they are used instead of the R2 variables above.
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION=""
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""
OBJECT_STORAGE_BUCKET="oncehere-media"
OBJECT_STORAGE_FORCE_PATH_STYLE="false"

# Optional: total media-storage planning budget in bytes for the private Admin
# Health dashboard. If omitted on Backblaze B2, OnceHere shows the provider's
# 10 GB free-tier reference and clearly labels it as account-wide rather than an
# exact bucket quota.
OBJECT_STORAGE_BUDGET_BYTES=""

# Optional Cloudflare media CDN for deployed PUBLIC archives only.
# Leave both empty to keep the existing direct signed-object behavior.
# MEDIA_CDN_BASE_URL should be the HTTPS workers.dev/custom-domain URL with no path.
MEDIA_CDN_BASE_URL=""
# Generate a random 32+ byte secret and configure the exact same value as
# ORIGIN_SECRET in the Cloudflare Worker. This secret only prevents redirect loops;
# private/draft archive authorization is still enforced by OnceHere itself.
MEDIA_CDN_ORIGIN_SECRET=""
